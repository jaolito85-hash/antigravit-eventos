# =============================================================
# Tuca | Tropicadelia 2026
# Copie para .env e preencha. O /health exige as marcadas com (*)
# =============================================================

# Supabase
SUPABASE_URL=https://your-project.supabase.co
# (*) Exclusiva do backend. Nunca use em HTML ou JavaScript.
SUPABASE_SERVICE_ROLE_KEY=
EVENT_SLUG=tropicadelia-2026
# (*) Sal do HMAC que pseudonimiza telefones (LGPD)
PII_HASH_SECRET=

# WhatsApp Cloud API oficial da Meta
# Sem estas tres, o bot nao recebe nem responde nada:
META_APP_ID=
# (*) App > Configuracoes > Basico > Chave secreta do app
META_APP_SECRET=
# (*) Qualquer segredo seu; o mesmo valor vai no painel da Meta
META_VERIFY_TOKEN=
# Token permanente do usuario do sistema (usado pelo worker para enviar)
META_ACCESS_TOKEN=
META_WABA_ID=
# (*) WhatsApp > Configuracao da API > ID do numero de telefone
META_PHONE_NUMBER_ID=
META_GRAPH_API_VERSION=v26.0

# IA de urgência e resposta (opcional: sem ela o bot cai nas respostas fixas)
OPENAI_API_KEY=
# Confira em /v1/models o que o seu projeto acessa antes de trocar.
# Verificado em 19/09/2026: gpt-5.6-luna devolve 403 nesta chave.
OPENAI_MODEL=gpt-5.4-mini

# Aplicacao
PORT=5001
FLASK_ENV=production
# (*)
SECRET_KEY=
# (*)
ADMIN_USER=
# (*)
ADMIN_PASS=
LOG_LEVEL=INFO

# Worker
WORKER_POLL_INTERVAL=1
WORKER_MAX_ATTEMPTS=8
