# =============================================================
# Tuca | Tropicadelia 2026
# Copie para .env e preencha. O /health exige as marcadas com (*)
# =============================================================

# Supabase
SUPABASE_URL=https://your-project.supabase.co
# (*) Exclusiva do backend. Nunca use em HTML ou JavaScript.
SUPABASE_SERVICE_ROLE_KEY=
EVENT_SLUG=tropicadelia-2026
# (*) Sal do HMAC que pseudonimiza telefones (LGPD)
PII_HASH_SECRET=

# WhatsApp Cloud API oficial da Meta
# Sem estas tres, o bot nao recebe nem responde nada:
META_APP_ID=
# (*) App > Configuracoes > Basico > Chave secreta do app
META_APP_SECRET=
# (*) Qualquer segredo seu; o mesmo valor vai no painel da Meta
META_VERIFY_TOKEN=
# Token permanente do usuario do sistema (usado pelo worker para enviar)
META_ACCESS_TOKEN=
META_WABA_ID=
# (*) WhatsApp > Configuracao da API > ID do numero de telefone
META_PHONE_NUMBER_ID=
META_GRAPH_API_VERSION=v26.0
# Numero publico do WhatsApp, so digitos, sem + nem espacos, na forma sem o nono
# digito (e o wa_id que a Meta usa e a forma que o link wa.me abre o perfil certo).
# Preenche o campo da tela /qrcode e o link de divulgacao. Se vazio, cai no default do codigo.
WHATSAPP_PUBLIC_NUMBER=554367270996

# IA de urgência e resposta (opcional: sem ela o bot cai nas respostas fixas)
OPENAI_API_KEY=
# Confira em /v1/models o que o seu projeto acessa antes de trocar: o projeto
# tropicadelia libera so gpt-5.6-luna e whisper-1, e nega o resto com 403.
OPENAI_MODEL=gpt-5.6-luna

# Aplicacao
PORT=5001
FLASK_ENV=production
# (*)
SECRET_KEY=
# (*)
ADMIN_USER=
# (*)
ADMIN_PASS=
# Contas extras do painel, uma por pessoa: "nome:senha,outro:senha". O nome
# fica no histórico de publicação. Tirar alguém é apagar o par daqui.
ADMIN_USERS=
LOG_LEVEL=INFO

# Worker
WORKER_POLL_INTERVAL=1
WORKER_MAX_ATTEMPTS=8

# Agente de operacao no Telegram (servico "agente" do compose)
# Token do bot criado no @BotFather. Sem ele o servico fica parado, sem erro.
TELEGRAM_BOT_TOKEN=
# Ids dos chats que podem falar com o agente, separados por virgula.
# Mande /id para o bot dentro do grupo para descobrir o id (grupos sao negativos).
TELEGRAM_CHAT_IDS=
# Onde os alertas da varredura chegam. Vazio: o primeiro de TELEGRAM_CHAT_IDS.
TELEGRAM_ALERT_CHAT_ID=
# Varredura completa a cada N minutos, e vigia de chamados criticos a cada N segundos (0 desliga).
MONITOR_INTERVAL_MIN=30
MONITOR_VIGIA_SEG=60
# Ponte com o agente da nuvem: problema vira issue, correcao vira PR aprovado no Telegram.
# Token fine-grained do GitHub so para este repositorio, com Issues, Pull requests e Contents em leitura e escrita.
GITHUB_TOKEN=
GITHUB_REPO=jaolito85-hash/antigravit-eventos

# Opcional: terceiro motor do laboratorio. Tambem configuravel pelo painel.
TYPESAFE_API_KEY=
# Se usar outro caminho, monte um volume privado persistente nesse local.
# TUCA_JEV_CONFIG_FILE=/app/instance/tuca-jev.json
