# Supabase
SUPABASE_URL=https://your-project.supabase.co
# Exclusiva do backend. Nunca use em HTML ou JavaScript.
SUPABASE_SERVICE_ROLE_KEY=
EVENT_SLUG=tropicadelia-2026
PII_HASH_SECRET=

# WhatsApp Cloud API oficial
META_APP_ID=
META_APP_SECRET=
META_VERIFY_TOKEN=
META_ACCESS_TOKEN=
META_WABA_ID=
META_PHONE_NUMBER_ID=
META_GRAPH_API_VERSION=

# IA de urgência no worker da API oficial da Meta
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna

# Aplicação
PORT=5001
FLASK_ENV=production
SECRET_KEY=
ADMIN_USER=
ADMIN_PASS=
LOG_LEVEL=INFO

# Worker
WORKER_POLL_INTERVAL=1
WORKER_MAX_ATTEMPTS=8

# Compatibilidade Evolution desativada por padrão
ENABLE_EVOLUTION_WEBHOOK=false
EVOLUTION_WEBHOOK_SECRET=
EVOLUTION_API_URL=
EVOLUTION_API_KEY=
EVOLUTION_INSTANCE_NAME=
